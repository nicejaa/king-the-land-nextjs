# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/king_the_land

# NextAuth v5 (AUTH_SECRET replaces NEXTAUTH_SECRET)
# Generate: openssl rand -base64 32
AUTH_SECRET=your-super-secret-key-min-32-chars
AUTH_URL=http://localhost:3000

# File Upload (optional - local or S3)
UPLOAD_DIR=public/uploads
